{
  "name": "smartconvert-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SmartConvert AI central API (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply smartconvert-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smartconvert-db --remote",
    "gen-key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "seed:test-site": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/make-test-site.ts",
    "signed-request": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/signed-request.ts",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "4.43.0"
  }
}
